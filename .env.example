# Copy this file to .env and fill in what you have. Anything left blank
# falls back to something that still works (see README).

# Where the contact and newsletter forms send submissions (e.g. Formspree).
VITE_FORM_ENDPOINT=

# Your public Cal.com or Calendly page for free consultations, e.g. https://cal.com/last-mile/intro-call
VITE_BOOKING_URL=

# Stripe customer portal link, so clients can update cards and invoices.
VITE_STRIPE_PORTAL_URL=

# Supabase (client login). Supabase > Project Settings > API.
# Leave blank to run the client area in preview mode with sample data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
